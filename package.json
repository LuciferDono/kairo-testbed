{
  "name": "parcelo-orders-api",
  "version": "1.4.2",
  "private": true,
  "description": "Orders and shipping API for Parcelo",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm run test -- --coverage && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "date-fns": "2.30.0",
    "express": "4.21.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "8.57.0",
    "supertest": "7.0.0",
    "tsx": "4.19.0",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
